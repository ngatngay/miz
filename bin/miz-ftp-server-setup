#!/usr/bin/env bash
set -e

INI_FILE="/miz-data/users_ftp.ini"
VIRT_FILE="/etc/vsftpd/virt_users"
VIRT_DB="/etc/vsftpd/virt_users.db"
USER_CONF_DIR="/etc/vsftpd/user_conf"
PAM_FILE="/etc/pam.d/vsftpd"
MAP_USER="www-data"

if [ "$(id -u)" -ne 0 ]; then
    echo "Phải chạy bằng root"
    exit 1
fi

if ! command -v crudini >/dev/null 2>&1; then
    echo "Thiếu crudini"
    exit 1
fi

if [ ! -f "$INI_FILE" ]; then
    echo "Không tồn tại $INI_FILE"
    exit 1
fi

cp -f /miz/tpl/vsftpd.conf /etc/vsftpd.conf

mkdir -p "$USER_CONF_DIR"
> "$VIRT_FILE"

users=$(crudini --get "$INI_FILE")

for user in $users; do
    pwd=$(crudini --get "$INI_FILE" "$user" pwd 2>/dev/null || true)
    dir=$(crudini --get "$INI_FILE" "$user" dir 2>/dev/null || true)

    if [ -z "$pwd" ]; then
        echo "User [$user] thiếu pwd"
        exit 1
    fi

    if [ -z "$dir" ]; then
        echo "User [$user] thiếu dir"
        exit 1
    fi

    if [ ! -d "$dir" ]; then
        mkdir -p "$dir"
    fi

    chown -R "$MAP_USER:$MAP_USER" "$dir"

    echo "$user" >> "$VIRT_FILE"
    echo "$pwd"  >> "$VIRT_FILE"

    cat > "$USER_CONF_DIR/$user" <<EOF
local_root=$dir
guest_username=$MAP_USER
virtual_use_local_privs=YES
EOF
done

db_load -T -t hash -f "$VIRT_FILE" "$VIRT_DB"
chmod 600 "$VIRT_FILE"
chmod 600 "$VIRT_DB"

# ----- TỰ ĐỘNG TẠO PAM -----
cat > "$PAM_FILE" <<EOF
auth required pam_userdb.so db=/etc/vsftpd/virt_users
account required pam_userdb.so db=/etc/vsftpd/virt_users
EOF

systemctl restart vsftpd

echo "Hoàn tất"

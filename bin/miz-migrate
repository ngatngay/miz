#!/usr/bin/env bash

set -euo pipefail

OLD="/miz_data"
STAMP="$(date +%Y%m%d%H%M%S)"
NEW="${OLD}_new.${STAMP}"
BACKUP="${OLD}.${STAMP}"
OLD_MOVED=0

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

cleanup() {
    local status=$?
    trap - EXIT

    if [ "$status" -ne 0 ]; then
        if [ "$OLD_MOVED" -eq 1 ] && [ ! -e "$OLD" ] && [ -d "$BACKUP" ]; then
            if ! mv -- "$BACKUP" "$OLD"; then
                printf 'error: rollback failed; backup remains at %s\n' "$BACKUP" >&2
            fi
        fi

        if [ -d "$NEW" ]; then
            rm -rf -- "$NEW"
        fi
    fi

    exit "$status"
}

build_json() {
    local source_dir="$1"
    local output_file="$2"

    {
        while IFS= read -r -d '' file; do
            local key
            key="$(basename -- "$file")"

            jq -n \
                --arg key "$key" \
                --rawfile value "$file" \
                '{
                    key: $key,
                    value: ($value | gsub("^\\s+|\\s+$"; ""))
                }'
        done < <(
            find "$source_dir" \
                -mindepth 1 \
                -maxdepth 1 \
                -type f \
                ! -name '.*' \
                -print0 |
                sort -z
        )
    } | jq -sS 'from_entries' > "$output_file"
}

trap cleanup EXIT

if [ ! -d "$OLD" ]; then
    fail "$OLD not found"
fi

if [ ! -d "$OLD/domains" ]; then
    fail "$OLD/domains not found"
fi

if ! command -v jq >/dev/null; then
    fail "jq not found"
fi

if [ -e "$NEW" ]; then
    fail "$NEW already exists"
fi

if [ -e "$BACKUP" ]; then
    fail "$BACKUP already exists"
fi

if [ -e "$OLD/settings.json" ]; then
    fail "$OLD/settings.json already exists"
fi

while IFS= read -r -d '' file; do
    fail "domain JSON already exists: $file"
done < <(
    find "$OLD/domains" \
        -mindepth 2 \
        -maxdepth 2 \
        -name 'data.json' \
        -print0
)

legacy_roots=("$OLD/domains")

if [ -d "$OLD/settings" ]; then
    legacy_roots+=("$OLD/settings")
fi

while IFS= read -r -d '' file; do
    fail ".data files are not supported: $file"
done < <(
    find "${legacy_roots[@]}" \
        -type f \
        -name '*.data' \
        -print0
)

while IFS= read -r -d '' domain_dir; do
    if [ ! -f "$domain_dir/domains" ]; then
        fail "missing domains field: $(basename -- "$domain_dir")"
    fi
done < <(
    find "$OLD/domains" \
        -mindepth 1 \
        -maxdepth 1 \
        -type d \
        -print0
)

printf 'copying %s -> %s\n' "$OLD" "$NEW"

cp -a -- "$OLD" "$NEW"

while IFS= read -r -d '' domain_dir; do
    json_tmp="$domain_dir/.data.json.migrate"

    build_json "$domain_dir" "$json_tmp"

    jq -e '
        type == "object"
        and has("domains")
        and (.domains | length > 0)
    ' "$json_tmp" >/dev/null

    find "$domain_dir" \
        -mindepth 1 \
        -maxdepth 1 \
        ! -name '.data.json.migrate' \
        -exec rm -rf -- {} +

    mv -- "$json_tmp" "$domain_dir/data.json"
done < <(
    find "$NEW/domains" \
        -mindepth 1 \
        -maxdepth 1 \
        -type d \
        -print0
)

settings_tmp="$NEW/.settings.json.migrate"

if [ -d "$NEW/settings" ]; then
    build_json "$NEW/settings" "$settings_tmp"
    rm -rf -- "$NEW/settings"
else
    printf '{}\n' > "$settings_tmp"
fi

mv -- "$settings_tmp" "$NEW/settings.json"

printf 'backup %s -> %s\n' "$OLD" "$BACKUP"
mv -- "$OLD" "$BACKUP"
OLD_MOVED=1

printf 'activate %s -> %s\n' "$NEW" "$OLD"
mv -- "$NEW" "$OLD"
OLD_MOVED=0

printf 'migration completed\n'
printf 'backup: %s\n' "$BACKUP"
printf 'deploy manually: /miz/bin/miz-lamp-deploy\n'
